# One HTTPS server for Android, iOS and Windows. No laptop or LAN discovery needed.
API_BASE_URL=https://teledrive.185.163.2.12.sslip.io/api
BACKEND_PINNED=true
# Preserve pre-migration device sessions. Change this for a DIFFERENT database.
BACKEND_IDENTITY=legacy-local
# For explicit local development, set BACKEND_PINNED=false and unset API_BASE_URL.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DIRECT_TELEGRAM_UPLOAD_ENABLED=true
DIRECT_TELEGRAM_DOWNLOAD_ENABLED=true
CLIENT_DERIVATIVE_GENERATION_ENABLED=true
GALLERY_BACKUP_ENABLED=true
MAX_CONCURRENT_TELEGRAM_UPLOADS=2
# Test hook for restart-recovery verification. Leave at zero normally.
TDLIB_E2E_COMMIT_DELAY_SECONDS=0
APP_UPDATE_MANIFEST_URL=https://github.com/ShekhawatPriya/TeleDrive/releases/latest/download/latest.json
APP_UPDATE_CHECKS_ENABLED=true
APP_UPDATE_CHECK_INTERVAL_MINUTES=30
# GitHub repository that hosts the source code and published Releases
# (powers the Project > Changelog screen and the in-app updater).
GITHUB_REPO_OWNER=ShekhawatPriya
GITHUB_REPO_NAME=TeleDrive
# Optional. Leave blank for public repos. Any value supplied here is compiled
# into the APK and can be extracted; never use a privileged long-lived token.
GITHUB_TOKEN=
