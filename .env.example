# Leave API_BASE_URL unset for automatic backend discovery: the app tries the
# last known address, the same machine (10.0.2.2 from the Android emulator),
# the backend's UDP discovery responder, then a LAN subnet scan — and re-checks
# every time the WiFi network changes. Set it only to pin a fixed address
# (e.g. a hosted backend); that disables auto-discovery.
# API_BASE_URL=http://10.0.2.2:8000/api
# Where discovery looks for the backend. Defaults match the backend's defaults;
# discovery uses UDP on the same port number as the API.
# BACKEND_PORT=8000
# BACKEND_API_PREFIX=/api
# BACKEND_DISCOVERY_PORT=8000
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DIRECT_TELEGRAM_UPLOAD_ENABLED=true
DIRECT_TELEGRAM_DOWNLOAD_ENABLED=true
CLIENT_DERIVATIVE_GENERATION_ENABLED=true
GALLERY_BACKUP_ENABLED=true
MAX_CONCURRENT_TELEGRAM_UPLOADS=2
# Test hook for restart-recovery verification. Leave at zero normally.
TDLIB_E2E_COMMIT_DELAY_SECONDS=0
APP_UPDATE_MANIFEST_URL=https://github.com/ShekhawatPriya/TG-Cloud-Drive/releases/latest/download/latest.json
APP_UPDATE_CHECKS_ENABLED=true
APP_UPDATE_CHECK_INTERVAL_MINUTES=30
# GitHub repository that hosts the source code and published Releases
# (powers the Project > Changelog screen and the in-app updater).
GITHUB_REPO_OWNER=ShekhawatPriya
GITHUB_REPO_NAME=TG-Cloud-Drive
# Optional. Leave blank for public repos. Any value supplied here is compiled
# into the APK and can be extracted; never use a privileged long-lived token.
GITHUB_TOKEN=
