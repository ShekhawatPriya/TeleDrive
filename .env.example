API_BASE_URL=http://192.168.1.15:8000/api
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
DIRECT_TELEGRAM_UPLOAD_ENABLED=true
DIRECT_TELEGRAM_DOWNLOAD_ENABLED=true
CLIENT_DERIVATIVE_GENERATION_ENABLED=true
GALLERY_BACKUP_ENABLED=true
GALLERY_BACKUP_WIFI_ONLY_DEFAULT=true
MAX_CONCURRENT_TELEGRAM_UPLOADS=2
MAX_CONCURRENT_DERIVATIVE_TASKS=2
MAX_CONCURRENT_GALLERY_UPLOADS=1
APP_UPDATE_MANIFEST_URL=https://github.com/ShekhawatPriya/TG-Cloud-Drive/releases/latest/download/latest.json
APP_UPDATE_CHECKS_ENABLED=true
APP_UPDATE_CHECK_INTERVAL_MINUTES=30
# GitHub repository that hosts the source code and published Releases
# (powers the Project > Changelog screen and the in-app updater).
GITHUB_REPO_OWNER=ShekhawatPriya
GITHUB_REPO_NAME=TG-Cloud-Drive
# Optional. Leave blank for public repos. Set a fine-grained/classic PAT only
# if the repo is private or you hit the unauthenticated rate limit (60/hr).
GITHUB_TOKEN=
